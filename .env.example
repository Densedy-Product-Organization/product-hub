###############################################################################
# Product Hub
# Environment Configuration Template
###############################################################################

############################################
# Application
############################################

APP_NAME=ProductHub
APP_ENVIRONMENT=Development
APP_URL=http://localhost:5000
APP_VERSION=0.1.0

############################################
# Database
############################################

DATABASE_PROVIDER=PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=producthub
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=ChangeMe

############################################
# Authentication
############################################

JWT_ISSUER=ProductHub
JWT_AUDIENCE=ProductHub
JWT_SECRET=ChangeThisToASecureSecret
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

############################################
# File Storage
############################################

STORAGE_PROVIDER=Local
STORAGE_PATH=./storage

############################################
# Email
############################################

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

############################################
# AI
############################################

AI_ENABLED=false
AI_PROVIDER=None

OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

ANTHROPIC_API_KEY=

GEMINI_API_KEY=

OLLAMA_ENDPOINT=http://localhost:11434

############################################
# AI Limits
############################################

AI_MONTHLY_BUDGET_USD=0
AI_MAX_REQUESTS_PER_DAY=100
AI_MAX_REQUESTS_PER_MONTH=1000
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=1000

############################################
# Logging
############################################

LOG_LEVEL=Information

############################################
# Security
############################################

ENABLE_SWAGGER=true
ENABLE_RATE_LIMITING=true
ENABLE_CORS=true

############################################
# Docker
############################################

DOCKER_CONTAINER_NAME=product-hub
DOCKER_NETWORK=product-hub-network